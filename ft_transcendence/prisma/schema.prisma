generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id           Int      @id @default(autoincrement())
  email    String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         String   @default("user")
  pages Page[]
}

model Page{
  id Int @id @default(autoincrement())
  title String
  text String
  authorId Int 
  author User @relation(fields:[authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  user
  admin
  moderator
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  timeFrom    DateTime
  timeTo      DateTime
  location    String
  organizer   String
  image       String?     
  description String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}