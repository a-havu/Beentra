generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  fullName           String?
  username           String              @unique
  phone              String?             @unique
  email              String              @unique
  passwordHash       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               Role                @default(admin)
  avatarUrl          String?
  pages              Page[]
  oauthAccount       OauthAccount[]
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  createdEvents      Event[]             @relation("EventCreator")
  eventSubscriptions EventSubscription[]
}

model Page {
  id        String   @id @default(cuid())
  title     String
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  user
  admin
  moderator
}

model Event {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("Student")
  date        DateTime
  timeFrom    DateTime
  timeTo      DateTime
  location    String
  organizer   String
  image       String?
  description String?
  maxSpots    Int      @default(0)
  creatorId   String?
  creator     User?    @relation("EventCreator", fields: [creatorId], references: [id])
  subscriptions EventSubscription[]

  publicCreatorId String?
  publicCreator   PublicApiUser? @relation(fields: [publicCreatorId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EventSubscription {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model OauthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // 'github', 'google', etc.
  providerUserId String // github's user id
  accessToken    String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId]) // one record per provider per user
}

model PublicApiUser {
  id           String   @id @default(cuid())
  email        String   @unique
  key          String   @unique
  publicUserId String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]
}
